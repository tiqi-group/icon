{
  "name": "icon-frontend",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
      "runtime": { "name": "node", "version": "26", "onFail": "download" }
  },
  "scripts": {
    "dev": "pnpm --filter icon run dev",
    "build": "pnpm run \"/^build:/\"",
    "build:icon": "pnpm --fail-if-no-match --filter icon run build",
    "build:visualizer": "pnpm --fail-if-no-match --filter ./sequence-visualizer run build --outDir ../../src/icon/server/frontend_visualizer --emptyOutDir",
    "lint": "pnpm --filter icon run lint",
    "test": "pnpm --filter icon run test"
  }
}
