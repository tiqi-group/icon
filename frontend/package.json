{
  "name": "icon-frontend",
  "private": true,
  "workspaces": [
    "icon",
    "sequence-visualizer"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "npm --workspace=icon run dev",
    "build": "npm run build:icon && npm run build:visualizer",
    "build:icon": "npm --workspace=icon run build",
    "build:visualizer": "npm --workspace=sequence-visualizer run build -- --outDir ../../src/icon/server/frontend_visualizer --emptyOutDir",
    "lint": "npm --workspace=icon run lint",
    "test": "npm --workspace=icon run test"
  }
}
